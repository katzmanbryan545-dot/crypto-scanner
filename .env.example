# Crypto Bot Environment Variables

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (админ, получающий алерты)
MY_TELEGRAM_ID=your_telegram_id_here

# Google Sheets ID (из URL таблицы)
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# OpenAI API Key (для gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API Key (для поиска новостей)
TAVILY_API_KEY=your_tavily_api_key_here
